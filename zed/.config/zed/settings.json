  "edit_predictions": {
    "provider": "zed",
  },
  "search": {
    "include_ignored": false,
  },
  "file_finder": {
    "include_ignored": "smart",
  },
  "languages": {
    "Rust": {
      "show_edit_predictions": false,
      "show_completions_on_input": true,
    },
    "Python": {
      "format_on_save": "off",
      "language_servers": ["ty", "!basedpyright", "!pyright", "..."],
    },
  },
  "window_decorations": "client",
  "session": {
    "trust_all_worktrees": true,
  },
  "agent": {
    "profiles": {
      "custom": {
        "default_model": {
          "provider": "Z.AI",
          "model": "glm-4.7",
          "enable_thinking": false
        },
        "name": "Custom",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "notify_when_agent_waiting": "never",
    "tool_permissions": {
      "tools": {
        "fetch": {
          "default": "allow"
        },
        "terminal": {
          "always_allow": [
            {
              "pattern": "^psql\\b"
            },
            {
              "pattern": "^PGPASSWORD=viktor\\s+psql(\\s|$)"
            },
            {
              "pattern": "^hyprctl\\s+getoption(\\s|$)"
            },
            {
              "pattern": "^echo\\b"
            },
            {
              "pattern": "^cargo\\s+tree(\\s|$)"
            },
            {
              "pattern": "^grep\\s+tower-sessions-core(\\s|$)"
            }
          ]
        },
        "move_path": {
          "default": "allow"
        },
        "create_directory": {
          "default": "allow",
        },
      },
    },
    "default_profile": "write",
    "dock": "left",
    "default_model": {
      "enable_thinking": false,
      "provider": "Z.AI",
      "model": "glm-5.1",
    },
    "model_parameters": [],
  },
  "outline_panel": {
    "dock": "left",
    "button": false,
  },
  "git_panel": {
    "dock": "left",
    "status_style": "icon",
  },
  "notification_panel": {
    "button": false,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "diagnostics": {
    "button": true,
  },
  "terminal": {
    "button": false,
  },
  "status_bar": {
    "cursor_position_button": false,
    "active_language_button": true,
  },
  "debugger": {
    "button": false,
  },
  "project_panel": {
    "button": true,
    "dock": "right",
  },
  "ui_font_weight": 400.0,
  "ui_font_family": ".ZedSans",
  "buffer_font_family": "Hack Nerd Font",
  "icon_theme": "VSCode Great Icons Theme",
  "ui_font_size": 20.0,
  "buffer_font_size": 15,
  // "theme": "Gruvbox Dark",
  "hover_popover_enabled": false,
  "show_completions_on_input": false,
  "language_models": {
    "openai_compatible": {
