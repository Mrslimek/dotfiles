[Default Applications]
# ===== Браузер (Zen) =====
x-scheme-handler/http=zen.desktop
x-scheme-handler/https=zen.desktop
x-scheme-handler/chrome=zen.desktop
text/html=zen.desktop
application/x-extension-htm=zen.desktop
application/x-extension-html=zen.desktop
application/x-extension-shtml=zen.desktop
application/xhtml+xml=zen.desktop
application/x-extension-xhtml=zen.desktop
application/x-extension-xht=zen.desktop

# ===== Прочие URL-схемы =====
x-scheme-handler/zcode=zcode.desktop

# ===== Видео → mpv =====
video/mp4=mpv.desktop
video/mpeg=mpv.desktop
video/x-mpeg=mpv.desktop
video/x-mpeg2=mpv.desktop
video/x-matroska=mpv.desktop
video/webm=mpv.desktop
video/quicktime=mpv.desktop
video/x-msvideo=mpv.desktop
video/x-msvideo-plugin=mpv.desktop
video/x-ms-wmv=mpv.desktop
video/x-flv=mpv.desktop
video/x-flic=mpv.desktop
video/3gpp=mpv.desktop
video/3gpp2=mpv.desktop
video/dv=mpv.desktop
video/ogg=mpv.desktop
video/x-ogm+ogg=mpv.desktop
video/x-theora+ogg=mpv.desktop
video/vnd.divx=mpv.desktop
video/vnd.mpegurl=mpv.desktop
video/x-m4v=mpv.desktop
video/x-nsv=mpv.desktop
video/mj2=mpv.desktop
application/ogg=mpv.desktop
application/x-ogg=mpv.desktop
application/x-matroska=mpv.desktop
application/x-shockwave-flash=mpv.desktop

# ===== Аудио → mpv =====
audio/mpeg=mpv.desktop
audio/mp3=mpv.desktop
audio/x-mp3=mpv.desktop
audio/mpeg3=mpv.desktop
audio/x-mpeg3=mpv.desktop
audio/mp4=mpv.desktop
audio/m4a=mpv.desktop
audio/x-m4a=mpv.desktop
audio/mp2=mpv.desktop
audio/x-aiff=mpv.desktop
audio/aac=mpv.desktop
audio/x-aac=mpv.desktop
audio/flac=mpv.desktop
audio/x-flac=mpv.desktop
audio/x-wav=mpv.desktop
audio/wav=mpv.desktop
audio/x-ms-wma=mpv.desktop
audio/ogg=mpv.desktop
audio/x-vorbis+ogg=mpv.desktop
audio/x-speex+ogg=mpv.desktop
audio/x-opus+ogg=mpv.desktop
audio/opus=mpv.desktop
audio/vnd.rn-realaudio=mpv.desktop
audio/x-pn-realaudio=mpv.desktop
audio/basic=mpv.desktop
audio/x-musepack=mpv.desktop
audio/x-tta=mpv.desktop
audio/x-wavpack=mpv.desktop

# ===== Изображения → imv =====
image/png=imv.desktop
image/jpeg=imv.desktop
image/jpg=imv.desktop
image/gif=imv.desktop
image/bmp=imv.desktop
image/x-bmp=imv.desktop
image/x-ms-bmp=imv.desktop
image/tiff=imv.desktop
image/x-tiff=imv.desktop
image/webp=imv.desktop
image/avif=imv.desktop
image/heic=imv.desktop
image/heif=imv.desktop
image/svg+xml=imv.desktop
image/svg=imv.desktop
image/x-portable-pixmap=imv.desktop
image/x-portable-bitmap=imv.desktop
image/x-portable-graymap=imv.desktop
image/x-portable-anymap=imv.desktop
image/x-xbitmap=imv.desktop
image/x-xpixmap=imv.desktop
image/x-tga=imv.desktop
image/vnd.microsoft.icon=imv.desktop
image/x-icon=imv.desktop
image/jxl=imv.desktop

# ===== PDF → Zen (браузер) =====
application/pdf=zen.desktop
application/x-pdf=zen.desktop
application/x-bzpdf=zen.desktop
application/x-gzpdf=zen.desktop
application/postscript=zen.desktop
image/vnd.djvu=zen.desktop
image/x.djvu=zen.desktop

# ===== Директории / файловый менеджер → Nautilus =====
inode/directory=org.gnome.Nautilus.desktop
inode/mount-point=org.gnome.Nautilus.desktop
x-scheme-handler/file=org.gnome.Nautilus.desktop

# ===== Архивы → Nautilus (интеграция с File Roller) =====
application/zip=org.gnome.FileRoller.desktop
application/x-zip=org.gnome.FileRoller.desktop
application/x-zip-compressed=org.gnome.FileRoller.desktop
application/x-tar=org.gnome.FileRoller.desktop
application/x-gtar=org.gnome.FileRoller.desktop
application/x-bzip2=org.gnome.FileRoller.desktop
application/gzip=org.gnome.FileRoller.desktop
application/x-7z-compressed=org.gnome.FileRoller.desktop
application/x-rar=org.gnome.FileRoller.desktop
application/x-rar-compressed=org.gnome.FileRoller.desktop
application/x-xz=org.gnome.FileRoller.desktop

# ===== Текст/код → Zed (как было) =====
text/plain=dev.zed.Zed.desktop
text/css=dev.zed.Zed.desktop
text/javascript=dev.zed.Zed.desktop
text/markdown=dev.zed.Zed.desktop
text/x-csrc=dev.zed.Zed.desktop
text/x-chdr=dev.zed.Zed.desktop
text/x-c++src=dev.zed.Zed.desktop
text/x-c++hdr=dev.zed.Zed.desktop
text/x-python=dev.zed.Zed.desktop
text/x-rust=dev.zed.Zed.desktop
text/x-go=dev.zed.Zed.desktop
text/x-makefile=dev.zed.Zed.desktop
text/yaml=dev.zed.Zed.desktop
application/json=dev.zed.Zed.desktop
application/xml=dev.zed.Zed.desktop
application/javascript=dev.zed.Zed.desktop

# ===== Magnet/torrent → qBittorrent =====
application/x-bittorrent=org.qbittorrent.qBittorrent.desktop
x-scheme-handler/magnet=org.qbittorrent.qBittorrent.desktop
x-scheme-handler/anytype=anytype.desktop

[Added Associations]
