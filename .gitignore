# VSCodium trash and cache
**/VSCodium/**/CachedExtensionVSIXs/
**/VSCodium/**/CachedData/
**/VSCodium/**/Cache/
**/VSCodium/**/.trash/
**/VSCodium/**/User/workspaceStorage/

# Browser/messenger data — приватные данные приложений
# (профиль, cookies, история, кэш, индексы — не для dotfiles)
.config/.config/mozilla/
.config/.config/Element/

hyprland/.config/hypr/*.conf

# stow symlinks to system theme paths (dangling outside this machine)
gtk4.0/.config/gtk-4.0/assets
gtk4.0/.config/gtk-4.0/gtk-dark.css
gtk4.0/.config/gtk-4.0/gtk.css
