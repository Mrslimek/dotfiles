[global]
    width = 300
    height = (0, 110)
    origin = top-right
    offset = (20, 20)
    
	font = Open Sans 11, Cantarell 11
    corner_radius = 11
    frame_width = 2
    
    background = "#1e1e1e"
    foreground = "#dedede"
    frame_color = "#78aeed"
    separator_color = "#353c45"

    padding = 12
    horizontal_padding = 15
    text_icon_padding = 10

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 270

    icon_theme = "Adwaita"
    enable_recursive_icon_lookup = true
    max_icon_size = 58
    icon_position = left
    min_icon_size = 32

    follow = mouse

    mouse_left_click = close_all

    # highlight = "#9dc3f3"
    highlight = "#78aeed"

### --- URGENCY LEVELS (ADWAITA PALETTE) --- ###

[urgency_low]
    background = "#1e1e1e"
    foreground = "#9a9996"
    timeout = 3

[urgency_normal]
    background = "#1e1e1e"
    foreground = "#dedede"
    timeout = 6

[urgency_critical]
    background = "#1e1e1e"
    foreground = "#e01b24"
    frame_color = "#e01b24"
    timeout = 0

### --- APPLICATION RULES --- ###

[telegram_rule]
    desktop_entry = org.telegram.desktop
    frame_color = "#3584e4"
    timeout = 10

[element_style]
    appname = io.element.Element.desktop
    frame_color = "#2ec27e"
    timeout = 10
